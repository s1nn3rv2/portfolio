---
import { Icon } from 'astro-icon/components';
---

<footer class="w-full py-12 border-t border-muted/10 flex flex-col sm:flex-row items-center justify-center gap-4 text-xs font-mono text-white/35 relative px-6 md:pl-24 md:pr-12 max-w-5xl mx-auto z-10">
    <div class="flex items-center gap-1 select-none">
        <span>made with</span>
        <span class="text-primary"><Icon name="mdi:heart" /></span>
        <span>in</span>
        <a href="https://astro.build" target="_blank" class="text-white/60 hover:text-primary transition-colors font-bold">Astro</a>
    </div>
    <span class="hidden sm:inline text-white/10 select-none">|</span>
    <a href="https://github.com/s1nn3rv2/portfolio" target="_blank" class="flex items-center gap-1 hover:text-white transition-colors">
        <Icon name="mdi:github" size={14}/>
        <span>Source code available</span>
    </a>
</footer>
