---
import { Icon } from 'astro-icon/components';

interface Props {
    company: string;
    role?: string;
    period: string;
    summary: string;
    points: string[];
    tags?: string[];
    link?: { label: string; href: string; icon?: string };
}

const { company, role, period, summary, points, tags = [], link } = Astro.props;
---

<article
    class="group relative border-l border-muted/30 pl-6 md:pl-8 pb-12 last:pb-0 transition-colors duration-300 hover:border-primary/60"
>
    <span
        class="absolute -left-1.25 top-1.5 h-2.5 w-2.5 rounded-full bg-muted transition-colors duration-300 group-hover:bg-primary"
    ></span>

    <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
        <h3 class="text-lg font-bold tracking-tight text-white md:text-xl">
            {company}
            {role && <span class="ml-3 font-mono text-sm font-normal text-primary/90">{role}</span>}
        </h3>
        <span class="whitespace-nowrap font-mono text-xs text-white/40">{period}</span>
    </div>

    <p class="mt-3 font-mono text-sm leading-relaxed text-gray-400">{summary}</p>

    <ul class="mt-4 space-y-2">
        {
            points.map((point) => (
                <li class="flex gap-3 text-sm leading-relaxed text-gray-300">
                    <span class="mt-0.5 select-none font-mono text-primary">▹</span>
                    <span>{point}</span>
                </li>
            ))
        }
    </ul>

    <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-3">
        {
            tags.length > 0 && (
                <div class="flex flex-wrap gap-2">
                    {tags.map((tag) => (
                        <span class="rounded border border-muted/40 px-2 py-0.5 font-mono text-xs text-white/50 transition-colors duration-300 group-hover:border-primary/30">
                            {tag}
                        </span>
                    ))}
                </div>
            )
        }

        {
            link && (
                <a
                    href={link.href}
                    target="_blank"
                    class="ml-auto inline-flex items-center gap-2 rounded-lg border border-primary/40 bg-primary/10 px-3 py-1.5 font-mono text-xs text-primary transition-all duration-300 hover:border-primary hover:bg-primary hover:text-dark"
                >
                    <Icon name={link.icon} size={15} />
                    <span>{link.label}</span>
                </a>
            )
        }
    </div>
</article>
