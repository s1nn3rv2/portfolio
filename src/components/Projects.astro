---
import { Icon } from 'astro-icon/components';
import Project from './Project.astro';

const projects = [
    {
        company: 'Pyroworks',
        role: 'Creator & Lead Developer',
        period: '2022 - Present',
        summary: 'A highly accurate PC pyrotechnics simulation game released on Steam.',
        points: [
            'Achieved over 700,000 unique downloads, building and scaling an active, global enthusiast community.',
            'Partnered with real-life industry manufacturers (including Funke, Blackboxx, Nico) to legally license and accurately translate physical pyrotechnic products into digital assets.',
            'Managed product deployment, full Steam pipeline integration and community features including Steam Workshop modding support for community-created assets.',
        ],
        tags: ['Unity', 'C#', 'Steamworks'],
        link: { label: 'View on Steam', href: '#', icon: 'mdi:steam' },
    },
    {
        company: 'Freelance',
        role: 'Web Developer',
        period: '2026 - Present',
        summary: "Designing and building high-performance web applications specialized to clients' needs.",
        points: [
            'Developed production-ready web applications using modern stacks and tools like SvelteKit, Astro and TailwindCSS.',
            'Configured modern cloud infrastructure utilizing Cloudflare and Google Cloud Platform.',
        ],
        tags: ['SvelteKit', 'Astro', 'TailwindCSS', 'Cloudflare', 'GCP'],
        link: { label: 'lunniestudio.com', href: 'https://lunniestudio.com', icon: 'mdi:web' },
    },
    {
        company: 'AnySpace',
        role: 'Mobile Application Developer',
        period: '2026 - Present',
        summary: 'A local-first mobile application built for physical space visual mapping.',
        points: [
            'Engineered a responsive, highly fluid mobile frontend using Flutter and Dart.',
            'Integrated AI capabilities via LLM APIs to automate smart spatial categorization and enhance user interaction.',
            'Managed the end-to-end release cycle including beta testing channels and live delivery on the Google Play Console.',
        ],
        tags: ['Flutter', 'Dart', 'LLM APIs', 'Play Console'],
        link: { label: 'Google Play', href: '#', icon: 'mdi:google-play' },
    },
];
---

<section
    id="projects"
    class="relative mx-auto flex min-h-screen max-w-6xl flex-col justify-start px-6 pt-32 pb-24 md:pr-12 md:pl-24"
>
    <header class="mb-14">
        <div class="flex items-center gap-2 font-mono text-sm text-primary">
            <Icon name="mdi:code-braces" size={18} />
            <span>/projects</span>
        </div>
        <h2 class="mt-3 text-3xl font-bold tracking-tighter text-white md:text-4xl">
            Projects &amp; Experience
        </h2>
    </header>

    <div>
        {projects.map((project) => <Project {...project} />)}
    </div>
</section>
