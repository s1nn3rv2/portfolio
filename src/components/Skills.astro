---
import { Icon } from 'astro-icon/components';

const groups = [
    { key: 'languages', values: ['TypeScript', 'C#', 'Rust', 'Ruby', 'Dart', 'Python'] },
    { key: 'frameworks', values: ['SvelteKit', 'Astro', 'React', 'TailwindCSS', 'Ruby on Rails'] },
    { key: 'backend', values: ['Node.js', 'SQL'] },
    { key: 'tooling', values: ['Docker', 'Google Cloud Platform', 'Cloudflare', 'Git', 'Unity'] },
];

const lineCount = groups.length + 3;
---

<section
    id="skills"
    class="relative mx-auto flex min-h-screen max-w-5xl flex-col justify-center px-6 pt-32 pb-24 md:pl-24 md:pr-12"
>
    <header class="mb-14">
        <h2 class="mt-3 text-3xl font-bold tracking-tighter text-white md:text-4xl">
            Skills &amp; Tools
        </h2>
    </header>

    <div
        class="overflow-hidden rounded-xl border border-muted/30 bg-dark/60 font-mono text-sm shadow-2xl shadow-black/40"
    >
        <div class="flex items-center gap-2 border-b border-muted/30 bg-surface/30 px-4 py-2.5">
            <span class="flex gap-1.5">
                <span class="h-3 w-3 rounded-full bg-muted/70"></span>
                <span class="h-3 w-3 rounded-full bg-muted/70"></span>
                <span class="h-3 w-3 rounded-full bg-muted/70"></span>
            </span>
            <span class="ml-2 flex items-center gap-1.5 text-xs text-white/40">
                <Icon name="mdi:language-typescript" size={14} />
                skills.ts
            </span>
        </div>

        <div class="flex overflow-x-auto">
            <div
                class="shrink-0 border-r border-muted/20 py-4 pr-4 pl-5 text-right leading-relaxed text-white/20 select-none"
            >
                {Array.from({ length: lineCount }, (_, i) => <div>{i + 1}</div>)}
            </div>

            <div class="py-4 pr-6 pl-4 leading-relaxed whitespace-pre">
                <div><span class="text-white/30">// stack &amp; tooling</span></div>
                <div>
                    <span class="text-[#c98a94]">const</span>{' '}
                    <span class="text-white/90">skills</span>{' '}
                    <span class="text-white/40">=</span>{' '}
                    <span class="text-white/40">&#123;</span>
                </div>
                {
                    groups.map((group) => (
                        <div>
                            {'  '}
                            <span class="text-white/90">{group.key}</span>
                            <span class="text-white/40">: [</span>
                            {group.values.map((value, i) => (
                                <>
                                    <span class="text-primary">"{value}"</span>
                                    {i < group.values.length - 1 && <span class="text-white/40">, </span>}
                                </>
                            ))}
                            <span class="text-white/40">],</span>
                        </div>
                    ))
                }
                <div><span class="text-white/40">&#125;</span></div>
            </div>
        </div>
    </div>
</section>
